# ZET web — Hetzner produksiya konfiguratsiyasi.
# Nusxa oling: cp .env.web.example .env.web

# Backend'ga ICHKI (konteynerlar orasi) manzil — tashqi domen EMAS.
ZET_API_URL=http://backend:8000

# Backend'dagi ZET_API_TOKEN bilan AYNAN bir xil bo'lishi shart —
# route handler shu tokenni backend'ga Bearer sifatida yuboradi.
ZET_API_TOKEN=
