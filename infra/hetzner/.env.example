# ZET backend — Hetzner produksiya konfiguratsiyasi.
#
# Nusxa oling: cp .env.example .env — VA SHU FAYLNI SERVERDA TO'LDIRING.
# HECH QACHON bu faylni chatga, GitHub'ga yoki boshqa joyga yubormang —
# .gitignore uni allaqachon istisno qiladi, lekin qo'lda ham ehtiyot
# bo'ling.
#
# `ZET_DATABASE_URL` / `ZET_REDIS_URL` / `ZET_OLLAMA_BASE_URL` bu yerda
# YO'Q — ular `docker-compose.prod.yml` ichida avtomatik, konteynerlar
# orasidagi DNS nomlari bilan (`postgres`, `redis`, `ollama`) o'rnatiladi.

# ── Postgres paroli (compose shu bilan konteyner yaratadi) ─────────
POSTGRES_PASSWORD=

# ── Ilova ────────────────────────────────────────────────────────
ZET_ENV=prod
ZET_LOG_LEVEL=INFO
ZET_TIMEZONE=Asia/Tashkent

# ── LLM: lokal Ollama (Hetzner'ning asosiy afzalligi — kvota yo'q) ──
ZET_OLLAMA_MODEL=qwen3:8b
ZET_OLLAMA_EMBED_MODEL=bge-m3
ZET_EMBEDDING_PROVIDER=ollama

# ── LLM: bulut zaxira (ixtiyoriy — Ollama yetmasa) ──────────────────
ZET_GOOGLE_API_KEY=
ZET_MISTRAL_API_KEY=
ZET_OPENROUTER_API_KEY=
ZET_COHERE_API_KEY=
ZET_ANTHROPIC_API_KEY=
ZET_CEREBRAS_API_KEY=
ZET_GROQ_API_KEY=
ZET_KIMI_API_KEY=
ZET_DEEPSEEK_API_KEY=

# ── Budjet chegaralari ───────────────────────────────────────────
ZET_BUDGET_MONTHLY_USD=10.0
ZET_BUDGET_DAILY_USD=0.50
ZET_RUN_MAX_USD=0.10
ZET_TIER3_DAILY_CALLS=5
ZET_AUTONOMOUS_BUDGET_SHARE=0.4

# ── Run chegaralari ──────────────────────────────────────────────
ZET_RUN_MAX_STEPS=20
ZET_RUN_MAX_DEPTH=3
ZET_RUN_TIMEOUT_S=600

# ── Xavfsizlik ───────────────────────────────────────────────────
ZET_OWNER_ID=owner
ZET_API_TOKEN=                   # MAJBURIY — kuchli tasodifiy qiymat
ZET_APPROVAL_TTL_MINUTES=30
ZET_ENABLE_SHELL=false

# ── Obsidian vault ───────────────────────────────────────────────
# `/data/vault` — `docker-compose.prod.yml`dagi `vault_data` nomlangan
# volume shu yo'lga bog'langan, shuning uchun `update.sh`/qayta qurish
# vaqtida yozuvlar YO'QOLMAYDI. Boshqa yo'lga o'zgartirsangiz, compose
# faylidagi mount nuqtasini ham mos ravishda yangilang.
ZET_VAULT_DIR=/data/vault

# Ixtiyoriy: `vault-sync` konteyneri (Obsidian-ulanish variant "b" —
# git-vault). Bo'sh qoldirilsa vault FAQAT serverda qoladi (variant
# "a"ga o'tganda ham shart emas — sync papka/Local REST API git
# talab qilmaydi). To'ldirilganda: private repo yarating, deploy
# token bilan HTTPS remote tuzing (masalan
# `https://x-access-token:<TOKEN>@github.com/<owner>/<repo>.git`) —
# bu qatorni FAQAT shu faylga, to'g'ridan-to'g'ri serverda yozing.
ZET_VAULT_GIT_REMOTE=
ZET_VAULT_GIT_BRANCH=main

# ── deploy.push sayt fayllari (F8, BLOCK-3 audit — MINIMAL: lokal fayl
# generatsiya, real hosting hali yo'q) ────────────────────────────
ZET_SITES_DIR=

# ── Telegram ─────────────────────────────────────────────────────
ZET_TELEGRAM_BOT_TOKEN=
ZET_TELEGRAM_OWNER_IDS=

# Mijoz do'kon boti — @BotFather'da ALOHIDA bot (Z51, #42). Bo'sh
# qoldirilsa mijoz DM'lari javobsiz qoladi (owner boti bunga javob
# bermaydi — ataylab, xavfsizlik uchun; shop_bot.py'dagi izohga qarang).
ZET_SHOP_BOT_TOKEN=

# ── GitHub / Web qidiruv / YouTube (ixtiyoriy) ──────────────────────
ZET_GITHUB_TOKEN=
ZET_WEB_SEARCH_API_KEY=
ZET_YOUTUBE_API_KEY=
ZET_YOUTUBE_OAUTH_CLIENT_ID=
ZET_YOUTUBE_OAUTH_CLIENT_SECRET=
ZET_YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Instagram (ixtiyoriy) ────────────────────────────────────────
ZET_INSTAGRAM_ACCESS_TOKEN=
ZET_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Ovoz ─────────────────────────────────────────────────────────
ZET_STT_LANGUAGE=uzb

# Lokal, self-hosted STT/TTS (ADR-0007 — lokal birinchi, $0). Model
# yo'llari default'da /data/voice-models/... ga ishora qiladi — bu
# yerda QAYTA yozish shart EMAS, faqat scripts/prepare_voice_models.py
# birinchi marta ishga tushirilganini tasdiqlash kifoya (bo'sh
# qoldirilsa ham default qiymatlar ishlaydi).
# ZET_WHISPER_MODEL_PATH=/data/voice-models/whisper-uz-ct2
# ZET_MMS_TTS_MODEL_PATH=/data/voice-models/mms-tts-uz

# Navoiy TTS (CosyVoice2, GPU) — ALOHIDA GPU serverida joylashtirilgan
# bo'lsa, shu yerga manzilini yozing (bo'sh = o'chiq, MmsTTS'ga
# tushiladi). infra/hetzner/navoiy-tts-service/README.md'ga qarang.
ZET_NAVOIY_TTS_BASE_URL=

ZET_AZURE_SPEECH_KEY=
ZET_AZURE_SPEECH_REGION=
ZET_AZURE_VOICE=uz-UZ-SardorNeural
ZET_ELEVENLABS_API_KEY=
ZET_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Kamera (ixtiyoriy) ───────────────────────────────────────────
ZET_HIKVISION_HOST=
ZET_HIKVISION_USERNAME=
ZET_HIKVISION_PASSWORD=
ZET_HIKVISION_CHANNEL=1

# ── Domenlar (Caddy uchun — bo'sh qoldirilsa IP:port rejimi) ────────
ZET_DOMAIN=
ZET_API_DOMAIN=
