# ZET backend — Hetzner produksiya konfiguratsiyasi.
#
# Nusxa oling: cp .env.example .env — VA SHU FAYLNI SERVERDA TO'LDIRING.
# HECH QACHON bu faylni chatga, GitHub'ga yoki boshqa joyga yubormang —
# .gitignore uni allaqachon istisno qiladi, lekin qo'lda ham ehtiyot
# bo'ling.
#
# `ZET_DATABASE_URL` / `ZET_REDIS_URL` / `ZET_OLLAMA_BASE_URL` bu yerda
# YO'Q — ular `docker-compose.prod.yml` ichida avtomatik, konteynerlar
# orasidagi DNS nomlari bilan (`postgres`, `redis`, `ollama`) o'rnatiladi.

# ── Postgres paroli (compose shu bilan konteyner yaratadi) ─────────
POSTGRES_PASSWORD=

# ── Ilova ────────────────────────────────────────────────────────
ZET_ENV=prod
ZET_LOG_LEVEL=INFO
ZET_TIMEZONE=Asia/Tashkent

# ── LLM: lokal Ollama (Hetzner'ning asosiy afzalligi — kvota yo'q) ──
ZET_OLLAMA_MODEL=qwen3:8b
ZET_OLLAMA_EMBED_MODEL=bge-m3
ZET_EMBEDDING_PROVIDER=ollama

# ── LLM: bulut zaxira (ixtiyoriy — Ollama yetmasa) ──────────────────
ZET_GOOGLE_API_KEY=
ZET_MISTRAL_API_KEY=
ZET_OPENROUTER_API_KEY=
ZET_COHERE_API_KEY=
ZET_ANTHROPIC_API_KEY=

# ── Budjet chegaralari ───────────────────────────────────────────
ZET_BUDGET_MONTHLY_USD=10.0
ZET_BUDGET_DAILY_USD=0.50
ZET_RUN_MAX_USD=0.10
ZET_TIER3_DAILY_CALLS=5
ZET_AUTONOMOUS_BUDGET_SHARE=0.4

# ── Run chegaralari ──────────────────────────────────────────────
ZET_RUN_MAX_STEPS=20
ZET_RUN_MAX_DEPTH=3
ZET_RUN_TIMEOUT_S=600

# ── Xavfsizlik ───────────────────────────────────────────────────
ZET_OWNER_ID=owner
ZET_API_TOKEN=                   # MAJBURIY — kuchli tasodifiy qiymat
ZET_APPROVAL_TTL_MINUTES=30
ZET_ENABLE_SHELL=false

# ── Obsidian vault ───────────────────────────────────────────────
ZET_VAULT_DIR=

# ── Telegram ─────────────────────────────────────────────────────
ZET_TELEGRAM_BOT_TOKEN=
ZET_TELEGRAM_OWNER_IDS=

# ── GitHub / Web qidiruv / YouTube (ixtiyoriy) ──────────────────────
ZET_GITHUB_TOKEN=
ZET_WEB_SEARCH_API_KEY=
ZET_YOUTUBE_API_KEY=
ZET_YOUTUBE_OAUTH_CLIENT_ID=
ZET_YOUTUBE_OAUTH_CLIENT_SECRET=
ZET_YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Instagram (ixtiyoriy) ────────────────────────────────────────
ZET_INSTAGRAM_ACCESS_TOKEN=
ZET_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Ovoz ─────────────────────────────────────────────────────────
ZET_STT_LANGUAGE=uzb
ZET_AZURE_SPEECH_KEY=
ZET_AZURE_SPEECH_REGION=
ZET_AZURE_VOICE=uz-UZ-SardorNeural
ZET_ELEVENLABS_API_KEY=
ZET_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Kamera (ixtiyoriy) ───────────────────────────────────────────
ZET_HIKVISION_HOST=
ZET_HIKVISION_USERNAME=
ZET_HIKVISION_PASSWORD=
ZET_HIKVISION_CHANNEL=1

# ── Domenlar (Caddy uchun — bo'sh qoldirilsa IP:port rejimi) ────────
ZET_DOMAIN=
ZET_API_DOMAIN=
