# ZET konfiguratsiyasi — nusxa oling: cp .env.example .env
# .env HECH QACHON commit qilinmaydi (.gitignore + gitleaks tekshiradi)

# ── Ilova ──────────────────────────────────────────────────────────
ZET_ENV=dev                      # dev | test | prod
ZET_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
ZET_TIMEZONE=Asia/Tashkent

# ── Ma'lumotlar bazasi / navbat ────────────────────────────────────
# Local-first (ADR-0007): Postgres shart emas — SQLite bilan ham ishlaydi,
# masalan: ZET_DATABASE_URL=sqlite+aiosqlite:///./data/zet.db
ZET_DATABASE_URL=postgresql+asyncpg://zet:zet@localhost:5432/zet
ZET_REDIS_URL=redis://localhost:6379/0

# ── LLM: T0 — lokal, bepul (ADR-0006) ──────────────────────────────
# 16 GB RAM uchun 7-8B modellar tavsiya etiladi.
ZET_OLLAMA_BASE_URL=http://localhost:11434
ZET_OLLAMA_MODEL=qwen3:8b
ZET_OLLAMA_EMBED_MODEL=bge-m3

# ── LLM: T1 — free tier (kvota chegarasida bepul) ──────────────────
ZET_GOOGLE_API_KEY=
ZET_GROQ_API_KEY=
ZET_MISTRAL_API_KEY=
ZET_OPENROUTER_API_KEY=

# ── LLM: T2 / T3 — to'lovli (qattiq chegara ostida) ────────────────
ZET_ANTHROPIC_API_KEY=
ZET_OPENAI_API_KEY=

# ── Budjet chegaralari (fail-closed: oshsa run RAD ETILADI) ────────
ZET_BUDGET_MONTHLY_USD=10.0
ZET_BUDGET_DAILY_USD=0.50
ZET_RUN_MAX_USD=0.10
ZET_TIER3_DAILY_CALLS=5          # kuchli modelga kunlik chaqiruv limiti
ZET_AUTONOMOUS_BUDGET_SHARE=0.4  # jadval vazifalariga ajratilgan ulush

# ── Run chegaralari (A-07: cheksiz sikl tormozlari) ────────────────
ZET_RUN_MAX_STEPS=20
ZET_RUN_MAX_DEPTH=3
ZET_RUN_TIMEOUT_S=600

# ── Xavfsizlik ─────────────────────────────────────────────────────
ZET_OWNER_ID=owner
ZET_API_TOKEN=                   # prod'da MAJBURIY
ZET_APPROVAL_TTL_MINUTES=30
ZET_ENABLE_SHELL=false           # shell.exec tooli — ehtiyot bo'ling

# ── Telegram (V-17: to'liq boshqaruv paneli) ───────────────────────
# Token @BotFather'dan. Owner ID — @userinfobot orqali o'z Telegram
# ID'ingizni bilib oling. Ikkalasi ham bo'lmasa — bildirishnomalar
# faqat xotirada saqlanadi (StubNotifier), hech qayerga yuborilmaydi.
ZET_TELEGRAM_BOT_TOKEN=
ZET_TELEGRAM_OWNER_IDS=          # vergul bilan: "123456789,987654321"

# ── GitHub (Bo'lim 7 — Developer agent) ────────────────────────────
# Personal Access Token (repo scope). Bo'lmasa — github.read/write stub
# rejimda ishlaydi (haqiqiy API'ga chiqmaydi).
ZET_GITHUB_TOKEN=

# ── Web qidiruv (Bo'lim 7) ──────────────────────────────────────────
# Brave Search API — bepul qatlam: 2000 so'rov/oy (brave.com/search/api).
# Bo'lmasa — web.search stub rejimda ishlaydi.
ZET_WEB_SEARCH_API_KEY=

# ── Kamera — Hikvision (Bo'lim 8) ───────────────────────────────────
# ISAPI HTTP snapshot orqali (RTSP/FFmpeg shart emas). Uchalasi ham
# bo'lishi kerak — aks holda StubCamera (sintetik rasm) ishlatiladi.
ZET_HIKVISION_HOST=              # masalan: 192.168.1.64 yoki 192.168.1.64:80
ZET_HIKVISION_USERNAME=          # odatda: admin
ZET_HIKVISION_PASSWORD=
ZET_HIKVISION_CHANNEL=1          # NVR uchun 101, 201, ...; yagona kamera uchun 1
